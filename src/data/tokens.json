{
  "$meta": {
    "name": "Swiss-ai.org Design Tokens",
    "version": "2.0.0",
    "license": "Apache-2.0",
    "basedOn": "Material Design 3 (m3.material.io) — Apache-2.0",
    "tierStructure": [
      "reference: raw Apertus brand values",
      "system: M3 roles mapped to the Apertus palette",
      "component: component-scoped tokens (declared in src/styles/components.css)"
    ],
    "contrastVerification": "WCAG 2.2 AA ratios documented per role; see docs/accessibility.md"
  },
  "colors": {
    "reference": {
      "apertus-sky-blue-1-5": {
        "value": "#7BBBD5",
        "rgb": [123, 187, 213],
        "description": "Main brand surface color and icon-tile color"
      },
      "apertus-sky-blue-1-5-1": {
        "value": "#AACFDC",
        "rgb": [170, 205, 220],
        "description": "Supporting panel and pattern tone"
      },
      "apertus-sky-blue-1-5-2": {
        "value": "#BFD8E1",
        "rgb": [191, 216, 225],
        "description": "Supporting panel and pattern tone"
      },
      "apertus-anthracite": {
        "value": "#2E2F31",
        "rgb": [46, 47, 49],
        "description": "Primary text color"
      },
      "epfl-red": {
        "value": "#FF0000",
        "rgb": [255, 0, 0],
        "description": "Institutional accent — CTA identity, active states, focus rings"
      },
      "epfl-red-accessible": {
        "value": "#D40000",
        "rgb": [212, 0, 0],
        "derived": true,
        "description": "Accessible EPFL red derivative: 5.5:1 with white, used for button fills and small red text"
      },
      "white": {
        "value": "#FFFFFF",
        "rgb": [255, 255, 255],
        "description": "Dominant page background"
      }
    },
    "derived": {
      "pale-technical-panel": {
        "value": "#EAF5F8",
        "description": "Pale technical panel background (surface-container role)"
      },
      "pale-blue-wash": {
        "value": "#F3FAFC",
        "description": "Pale blue wash (surface-container-low role)"
      },
      "border-subtle": {
        "value": "rgba(46, 47, 49, 0.16)",
        "description": "Hairline border (outline-variant role)"
      },
      "border-blue": {
        "value": "rgba(123, 187, 213, 0.42)",
        "description": "Technical blue hairline accent"
      },
      "text-muted": {
        "value": "rgba(46, 47, 49, 0.72)",
        "description": "Muted text — 5.5:1 on white, passes AA body text"
      },
      "text-faint": {
        "value": "rgba(46, 47, 49, 0.56)",
        "description": "Faint text — 3.4:1 on white, large text only"
      },
      "disabled-surface": {
        "value": "#DDECEF",
        "description": "Disabled buttons and inactive states"
      },
      "disabled-text": {
        "value": "rgba(46, 47, 49, 0.48)",
        "description": "Disabled text"
      }
    },
    "system": {
      "md-sys-color-primary": "#FF0000",
      "md-sys-color-primary-interactive": "#D40000",
      "md-sys-color-on-primary": "#FFFFFF",
      "md-sys-color-primary-container": "#FFE3E3",
      "md-sys-color-on-primary-container": "#7D0000",
      "md-sys-color-secondary": "#7BBBD5",
      "md-sys-color-on-secondary": "#2E2F31",
      "md-sys-color-secondary-container": "#BFD8E1",
      "md-sys-color-on-secondary-container": "#2E2F31",
      "md-sys-color-tertiary": "#FFFFFF",
      "md-sys-color-on-tertiary": "#2E2F31",
      "md-sys-color-tertiary-container": "#F3FAFC",
      "md-sys-color-on-tertiary-container": "#2E2F31",
      "md-sys-color-error": "#B3261E",
      "md-sys-color-on-error": "#FFFFFF",
      "md-sys-color-error-container": "#F9DEDC",
      "md-sys-color-on-error-container": "#410E0B",
      "md-sys-color-surface": "#FFFFFF",
      "md-sys-color-surface-container-lowest": "#FFFFFF",
      "md-sys-color-surface-container-low": "#F3FAFC",
      "md-sys-color-surface-container": "#EAF5F8",
      "md-sys-color-surface-container-high": "#DDECEF",
      "md-sys-color-surface-container-highest": "#BFD8E1",
      "md-sys-color-on-surface": "#2E2F31",
      "md-sys-color-on-surface-variant": "rgba(46, 47, 49, 0.72)",
      "md-sys-color-outline": "rgba(46, 47, 49, 0.55)",
      "md-sys-color-outline-variant": "rgba(46, 47, 49, 0.16)"
    },
    "contrastNotes": [
      "Anthracite on white: 13.4:1 (AA and AAA body text)",
      "Anthracite on Apertus Sky Blue 1.5 (#7BBBD5): 6.3:1 (AA body text)",
      "White on #7BBBD5: 2.1:1 — fails AA; decorative surfaces only",
      "White on EPFL Red #FF0000: 4.0:1 — AA large text and UI components only",
      "White on #D40000 (accessible red): 5.5:1 — AA body text",
      "Anthracite on #BFD8E1: 9.0:1 (AA and AAA body text)"
    ]
  },
  "typography": {
    "fontFamilies": {
      "brand": {
        "name": "Inter",
        "weights": ["Light 300", "Bold 600", "Black 900"],
        "description": "Primary font for headings, body copy, labels, and navigation",
        "license": "SIL Open Font License 1.1 (loaded from Google Fonts, not bundled)"
      },
      "mono": {
        "name": "Geist Mono",
        "weights": ["Regular 400", "Bold 700"],
        "description": "Technical font for labels, metadata, code-like callouts",
        "license": "SIL Open Font License 1.1 (loaded from Google Fonts, not bundled)"
      }
    },
    "typeScale": {
      "display-large": { "size": "clamp(40px, 6vw, 56px)", "weight": "Black 900", "lineHeight": 1.05 },
      "headline-large": { "size": "clamp(32px, 5vw, 50px)", "weight": "Black 900", "lineHeight": 1.1, "role": "H1" },
      "headline-medium": { "size": "clamp(28px, 4vw, 38px)", "weight": "Black 900", "lineHeight": 1.1, "role": "H2" },
      "headline-small": { "size": "clamp(24px, 3vw, 32px)", "weight": "Black 900", "lineHeight": 1.2, "role": "H3" },
      "title-large": { "size": "clamp(20px, 2.5vw, 28px)", "weight": "Bold 600", "lineHeight": 1.3, "role": "H4" },
      "title-medium": { "size": "clamp(18px, 2vw, 22px)", "weight": "Black 900", "lineHeight": 1.3, "role": "H5 (uppercase)" },
      "title-small": { "size": "clamp(16px, 1.5vw, 20px)", "weight": "Bold 600", "lineHeight": 1.4, "role": "H6 (uppercase)" },
      "body-large": { "size": "clamp(16px, 1.6vw, 18px)", "weight": "Light 300", "lineHeight": 1.6 },
      "body-medium": { "size": "16px", "weight": "Light 300", "lineHeight": 1.6 },
      "body-small": { "size": "14px", "weight": "Light 300", "lineHeight": 1.55 },
      "label-large": { "size": "14px", "weight": "Bold 600", "lineHeight": 1.4, "letterSpacing": "0.08em", "transform": "uppercase" },
      "label-medium": { "size": "12px", "weight": "Bold 600", "lineHeight": 1.4, "letterSpacing": "0.08em", "transform": "uppercase" },
      "mono-large": { "size": "14px", "weight": "Bold 700", "lineHeight": 1.5, "family": "Geist Mono" },
      "mono-medium": { "size": "13px", "weight": "Bold 700", "lineHeight": 1.5, "family": "Geist Mono" },
      "mono-small": { "size": "12px", "weight": "Bold 700", "lineHeight": 1.5, "family": "Geist Mono" }
    }
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
    "unit": "px",
    "baselineGrid": 4,
    "description": "Apertus spacing scale; aligns with M3 4dp spacing rc tokens"
  },
  "shape": {
    "mdSysShape": {
      "none": 0,
      "extraSmall": 4,
      "small": 8,
      "medium": 12,
      "large": 16,
      "extraLarge": 28,
      "full": 9999
    },
    "ApertusOverrides": {
      "buttons": "corner-none (rectangular)",
      "cards": "corner-card (6px, brand-capped)",
      "chips": "corner-full"
    }
  },
  "stateLayers": {
    "hover": 0.08,
    "focus": 0.12,
    "pressed": 0.12,
    "dragged": 0.16,
    "description": "Material Design 3 state layer opacities drawn with the on-color"
  },
  "elevation": {
    "level0": "none",
    "level1": "0 1px 2px rgba(46, 47, 49, 0.08)",
    "level2": "0 2px 6px rgba(46, 47, 49, 0.08)",
    "level3": "0 4px 12px rgba(46, 47, 49, 0.10)",
    "level4": "0 6px 18px rgba(46, 47, 49, 0.12)",
    "level5": "0 8px 24px rgba(46, 47, 49, 0.14)",
    "tinted": "0 4px 16px rgba(123, 187, 213, 0.28)",
    "description": "M3 elevation ladder lightened for the Apertus brand (no heavy shadows)"
  },
  "motion": {
    "durations": {
      "short3": 150,
      "short4": 200,
      "medium2": 300,
      "medium4": 400,
      "long2": 500
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "standardAccelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "emphasizedDecelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasizedAccelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)"
    },
    "reducedMotion": "prefers-reduced-motion: reduce disables non-essential animation"
  },
  "layout": {
    "containerMaxWidth": "1240px",
    "containerGutter": "24px",
    "gridColumns": { "desktop": 12, "tablet": 8, "mobile": 4 },
    "sectionPadding": { "desktop": 96, "tablet": 72, "mobile": 48 },
    "breakpoints": { "tablet": 1024, "mobile": 768, "smallMobile": 480 }
  },
  "zIndex": {
    "dropdown": 1000,
    "sticky": 1020,
    "fixed": 1030,
    "modal": 1040,
    "popover": 1050,
    "tooltip": 1060
  }
}
